# Rules apply to commands requesting execution outside the sandbox.
# The PreToolUse hook covers supported shell calls inside it as well.
prefix_rule(
    pattern = ["git", ["add", "commit", "push", "pull", "rebase", "revert", "merge"]],
    decision = "prompt",
    justification = "Confirm the contribution operation is within the human-approved phase.",
    match = ["git push fork HEAD", "git add src", "git rebase origin/main"],
    not_match = ["git status", "git diff"],
)

# Prefix rules cannot skip an arbitrary -C path. Conservatively prompt for
# escalated git -C calls; read-only in-sandbox operations still run normally.
prefix_rule(
    pattern = ["git", "-C"],
    decision = "prompt",
    justification = "Review the repository and operation before elevated Git access.",
)

prefix_rule(
    pattern = ["glab", "api"],
    decision = "prompt",
    justification = "glab api can write; confirm the call before it reaches GitLab.",
)

prefix_rule(
    pattern = ["glab", "mr", ["note", "comment", "create", "merge", "approve", "update", "close", "reopen"]],
    decision = "prompt",
    justification = "Confirm before posting or changing anything on the MR.",
)

prefix_rule(
    pattern = ["glab", "issue", ["create", "note", "comment", "update", "close", "reopen"]],
    decision = "prompt",
    justification = "Confirm before posting or changing anything on the issue.",
)

prefix_rule(
    pattern = ["glab", ["ci", "pipeline"], "run"],
    decision = "prompt",
    justification = "Confirm before triggering a pipeline.",
)

# Prefix rules cannot skip a leading -R/--repo; conservatively prompt.
prefix_rule(
    pattern = ["glab", ["-R", "--repo", "--hostname"]],
    decision = "prompt",
    justification = "Review the GitLab operation before elevated glab access.",
)

prefix_rule(
    pattern = ["drupalorg", ["issue:assign", "issue:unassign", "issue:reassign", "issue:label", "issue:unlabel", "issue:relabel", "issue:fork", "issue:get-access", "self:update"]],
    decision = "prompt",
    justification = "Confirm before posting a /do: command to the issue or updating the CLI.",
)
